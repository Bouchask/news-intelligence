DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: set DATABASE_URL=postgresql://news:news@localhost:5432/news_intelligence when PostgreSQL is running.
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BBC_DATASET_PATH=datasets/raw
BBC_NEWS_API_URL=https://bbc-news-api.vercel.app
SPARK_MASTER=local[*]
SPARK_APP_NAME=news-intelligence
MODEL_ARTIFACT_DIR=ml_artifacts
